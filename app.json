{
  "expo": {
    "name": "Revela",
    "slug": "revela",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141414",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ialcaniz.revela"
    },
    "android": {
      "package": "com.ialcaniz.revela",
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Revela necesita acceder a tus fotos para importarlas y editarlas."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Revela necesita acceder a tus fotos para guardar las imágenes editadas.",
          "savePhotosPermission": "Revela necesita permiso para guardar las imágenes editadas.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
