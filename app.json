{
  "expo": {
    "name": "Anota",
    "slug": "anota",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141414",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ialcaniz.anota"
    },
    "android": {
      "package": "com.ialcaniz.anota",
      "adaptiveIcon": {
        "backgroundColor": "#141414",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Anota necesita acceder a tus fotos para abrir capturas de pantalla."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Anota necesita acceder a tus fotos para encontrar tu última captura.",
          "savePhotosPermission": "Anota necesita permiso para guardar las capturas anotadas.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-router",
      "expo-sharing"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "anota"
  }
}
